root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

# gofmt mandates tabs and the CI runs a `go fmt` check. A tab width of 2 gives
# the look of 2-space indentation without breaking gofmt.
[{*.go,go.mod,go.sum}]
indent_style = tab
indent_size = 2
tab_width = 2

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2
